<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="192.0" prefWidth="305.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ro.mpp2026.client.controller.HomeController">
    <VBox prefHeight="390.0" prefWidth="532.0">
        <TableView fx:id="showsTable" prefHeight="200.0" prefWidth="200.0">
            <columns>
                <TableColumn fx:id="artistColumn" prefWidth="100.0" text="Artist" />
                <TableColumn fx:id="dateColumn" prefWidth="100.0" text="Date" />
                <TableColumn fx:id="locationColumn" prefWidth="100.0" text="Location" />
                <TableColumn fx:id="remainingSeatsColumn" prefWidth="100.0" text="Remaining Seats" />
                <TableColumn fx:id="soldSeatsColumn" prefWidth="100.0" text="Sold Seats" />
            </columns>
            <VBox.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </VBox.margin>
        </TableView>
        <HBox prefHeight="0.0" prefWidth="532.0">
            <TextField fx:id="artistSearchField" promptText="Artist">
                <HBox.margin>
                    <Insets left="10.0" />
                </HBox.margin>
            </TextField>
            <DatePicker fx:id="datePickerField" promptText="Date">
                <HBox.margin>
                    <Insets left="10.0" />
                </HBox.margin>
            </DatePicker>
            <Button fx:id="searchButton" mnemonicParsing="false" text="Search">
                <HBox.margin>
                    <Insets left="10.0" />
                </HBox.margin>
            </Button>
        </HBox>
      <HBox prefHeight="0.0" prefWidth="532.0">
         <children>
            <TextField promptText="Client's name" fx:id="clientsNameField">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </TextField>
            <TextField promptText="Number of seats" fx:id="numberOfSeatsField">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </TextField>
            <Button mnemonicParsing="false" text="Buy" fx:id="buyButton" />
            <Button mnemonicParsing="false" text="View all tickets" fx:id="viewAllTicketsButton" >
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin>
            </Button>
         </children>
         <padding>
            <Insets left="10.0" top="10.0" />
         </padding>
      </HBox>
      <Button mnemonicParsing="false" text="Logout" fx:id="logoutButton">
         <VBox.margin>
            <Insets left="10.0" top="10.0" />
         </VBox.margin>
      </Button>
        <Label fx:id="messageLabel" textFill="RED">
            <padding>
                <Insets left="10.0" />
            </padding>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Label>
    </VBox>
</AnchorPane>
