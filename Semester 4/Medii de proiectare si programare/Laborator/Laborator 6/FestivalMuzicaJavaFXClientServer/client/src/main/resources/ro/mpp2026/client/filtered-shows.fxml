<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ro.mpp2026.client.controller.FilteredShowsController">
    <VBox prefWidth="532.0">
        <TableView fx:id="showsTable" prefHeight="200.0" prefWidth="200.0">
            <columns>
                <TableColumn fx:id="artistColumn" prefWidth="100.0" text="Artist"/>
                <TableColumn fx:id="dateColumn" prefWidth="100.0" text="Date"/>
                <TableColumn fx:id="locationColumn" prefWidth="100.0" text="Location"/>
                <TableColumn fx:id="remainingSeatsColumn" prefWidth="100.0" text="Remaining Seats"/>
                <TableColumn fx:id="soldSeatsColumn" prefWidth="100.0" text="Sold Seats"/>
            </columns>
            <VBox.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </VBox.margin>
        </TableView>
    </VBox>
</AnchorPane>
