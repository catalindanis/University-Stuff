<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.tema.FriendshipsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <TableView fx:id="table" maxHeight="150.0" maxWidth="800.0" minHeight="150.0">
            <columns>
                <TableColumn fx:id="idCol" text="Id" />
                <TableColumn fx:id="firstUserCol" text="First user ID" />
                <TableColumn fx:id="secondUserCol" text="Second user ID" />
                <TableColumn fx:id="statusCol" text="Status" />
            </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
        </TableView>

        <GridPane>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Button alignment="TOP_RIGHT" mnemonicParsing="false" onAction="#onNextPage" text="Next" GridPane.columnIndex="2" />
                <TextFlow fx:id="textFlow" prefHeight="200.0" prefWidth="200.0" textAlignment="CENTER" GridPane.columnIndex="1">
                </TextFlow>
                <Button mnemonicParsing="false" onAction="#onPreviousPage" text="Previous" />
            </children>
        </GridPane>


        <GridPane hgap="20.0" vgap="20.0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="ALWAYS" />
                <RowConstraints />
            </rowConstraints>
            <children>
                <TextField fx:id="firstUser" promptText="First user ID" />
                <TextField fx:id="secondUser" promptText="Second user ID" GridPane.columnIndex="1" />
            </children>
        </GridPane>
        <HBox alignment="TOP_CENTER" prefHeight="0.0" prefWidth="600.0" spacing="20">
            <children>
                <Button mnemonicParsing="false" onAction="#onAddFriendship" text="Add" />
                <Button mnemonicParsing="false" onAction="#onDeleteFriendship" text="Delete" />
                <Button mnemonicParsing="false" onAction="#onNumberOfCommunities" text="Number of communities" />
                <Button mnemonicParsing="false" onAction="#onMostSociableCommunity" text="Most sociable community" />
            </children>
        </HBox>
    </children>
</VBox>
