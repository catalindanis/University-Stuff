<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.tema.FindFriendsController">
    <VBox spacing="5">
        <Text>My pending requests</Text>
        <ListView fx:id="myPendingFriendsList">
        </ListView>
        <Button fx:id="cancelRequestButton" text="Cancel request" />
      <HBox.margin>
         <Insets bottom="10.0" top="10.0" />
      </HBox.margin>
    </VBox>
    <VBox spacing="5">
        <Text>Others pending requests</Text>
        <ListView fx:id="othersPendingFriendsList">
        </ListView>
        <HBox>
            <Button fx:id="acceptRequestButton" text="Accept request" />
            <Button fx:id="rejectRequestButton" text="Reject request" />
        </HBox>
        <HBox.margin>
            <Insets bottom="10.0" top="10.0" />
        </HBox.margin>
    </VBox>
    <VBox spacing="5">
        <Text>Discover new people</Text>
        <ListView fx:id="nonFriendsList">
        </ListView>
        <Button fx:id="sendRequestButton" text="Send friend request" />
      <HBox.margin>
         <Insets bottom="10.0" top="10.0" />
      </HBox.margin>
    </VBox>
   <padding>
      <Insets left="20.0" right="20.0" />
   </padding>
</HBox>
