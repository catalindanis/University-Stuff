<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.ColumnConstraints?>
<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.tema.UserFriendsController">
    <children>
        <TableView fx:id="friendsTable" maxHeight="150.0" maxWidth="300.0" minHeight="150.0">
            <columns>
                <TableColumn fx:id="usernameCol" text="Friends" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <GridPane>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Button alignment="TOP_RIGHT" mnemonicParsing="false" onAction="#onNextPage" text="Next" GridPane.columnIndex="2" />
                <TextFlow fx:id="textFlow" prefHeight="200.0" prefWidth="200.0" textAlignment="CENTER" GridPane.columnIndex="1">
                </TextFlow>
                <Button mnemonicParsing="false" onAction="#onPreviousPage" text="Previous" />
            </children>
        </GridPane>

    </children>
</VBox>
