<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ComboBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.tema.ListDucksController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <TableView prefHeight="400.0" prefWidth="400.0" fx:id="table">
          <columns>
              <TableColumn fx:id="idCol" text="Id"/>
              <TableColumn fx:id="usernameCol" text="Name"/>
              <TableColumn fx:id="emailCol" text="Email"/>
              <TableColumn fx:id="passwordCol" text="Password"/>
              <TableColumn fx:id="typeCol" text="Type"/>
              <TableColumn fx:id="speedCol" text="Speed"/>
              <TableColumn fx:id="resistanceCol" text="Resistance"/>
              <TableColumn fx:id="groupCol" text="Group"/>
          </columns>
      </TableView>

       <ComboBox fx:id="duckTypeComboBox"
                 layoutX="50" layoutY="40"
                 prefWidth="200"
                 onAction="#onDuckTypeChanged"/>
   </children>
</VBox>
