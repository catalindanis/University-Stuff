<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.template.controller.UserController">
    <children>
        <TableView fx:id="table" maxHeight="150.0" maxWidth="550.0" minHeight="150.0">
            <columns>
                <TableColumn fx:id="nameCol" text="Name" />
                <TableColumn fx:id="priceCol" text="Price" />
<!--                <TableColumn fx:id="emailCol" text="Email" />-->
<!--                <TableColumn fx:id="passwordCol" text="Password" />-->
<!--                <TableColumn fx:id="typeCol" text="Type" />-->
<!--                <TableColumn fx:id="speedCol" text="Speed" />-->
<!--                <TableColumn fx:id="resistanceCol" text="Resistance" />-->
            </columns>
        </TableView>

        <Label fx:id="budgetLabel"></Label>

        <Button mnemonicParsing="false" fx:id="buyButton" text="Buy" />
        <Button mnemonicParsing="false" fx:id="sellButton" text="Sell" />
    </children>
</VBox>