diferenta([], _, []).
diferenta([H | T], B, [H | Rez]) :-
       aparitii(B, H, NrAp),
       NrAp is 0, !,
       diferenta(T, B, Rez).
diferenta([_ | T], B, Rez) :-
	diferenta(T, B, Rez).

elimina_multiple_aparitii([], []).
elimina_multiple_aparitii([H | T], [H | Rez]) :-
	aparitii([H | T], H, Ap1),
	Ap1 =:= 1, !,
	elimina_multiple_aparitii(T, Rez).
elimina_multiple_aparitii([H | T], Rez) :-
	elimina_toate_aparitiile([H | T], H, L),
	elimina_multiple_aparitii(L, Rez).

elimina_toate_aparitiile([], _, []).
elimina_toate_aparitiile([H | T], H, Rez) :- !,
	elimina_toate_aparitiile(T, H, Rez).
elimina_toate_aparitiile([H | T], E, [H | Rez]) :-
	elimina_toate_aparitiile(T, E, Rez).


aparitii([], _, 0).
aparitii([H | T], H, Rez) :- !,
	aparitii(T, H, Rez1),
	Rez is Rez1 + 1.
aparitii([_ | T], E, Rez) :-
	aparitii(T, E, Rez).

contopire(L, [], L).
contopire(L, [H | T], [H | Rez]) :-
	contopire(L, T, Rez).
